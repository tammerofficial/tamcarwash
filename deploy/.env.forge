# ---------------------------------------------------------------------------
# Tammer Wash — Production env template for Laravel Forge
# ---------------------------------------------------------------------------
# This file IS committed to git on purpose (no secrets here).
# deploy/forge-deploy.sh uses it to materialize/repair the server .env:
#   - If .env is missing on the server, it is created from this template.
#   - Operational keys below are force-synced into .env on every deploy.
#   - Secrets (APP_KEY, DB_PASSWORD) and Forge DB identity are NEVER overwritten:
#       DB_USERNAME, DB_PASSWORD, DB_DATABASE (Forge injects these when you link a DB)
# When attaching a custom domain, update APP_URL + the three domain keys here.
# ---------------------------------------------------------------------------

APP_NAME="Tammer Wash"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tamcarwash.on-forge.com
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# Database — MySQL (local Forge server OR Forge/DigitalOcean managed cluster)
#
# Local server: Forge → Site → Database links MySQL on 127.0.0.1:3306.
#
# Managed cluster (Forge → Server → Database Clusters):
#   DB_HOST=your-cluster.db.on-forge.com
#   DB_PORT=25060
#   DB_USERNAME=doadmin
#   DB_PASSWORD=<from Forge cluster credentials>
#   DB_DATABASE=<default cluster DB, e.g. tamcarwash>  ← Forge injects when linked
#   MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
#   MYSQL_SSL_VERIFY_SERVER_CERT=false
#
# LANDLORD_DB_DATABASE: platform schema (separate from Forge-linked default DB).
#   LANDLORD_DB_DATABASE=tamcarwash_landlord
# Create once on the cluster (Forge SQL console or mysql CLI with SSL):
#   CREATE DATABASE IF NOT EXISTS tamcarwash_landlord
#     CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
# Tenant schemas are created automatically on registration (tamcarwash_tenant_{slug}).
# doadmin on DO clusters has CREATE DATABASE — no extra GRANTs needed.
#
# ERROR 1044 "Access denied … to database tamcarwash_landlord"
#   Cause: site user lacks privileges on landlord/tenant schemas.
#   Fix A — dedicated landlord DB (recommended): create tamcarwash_landlord + grant:
#     GRANT ALL PRIVILEGES ON tamcarwash_landlord.* TO 'carwash'@'%';
#     GRANT ALL PRIVILEGES ON `tamcarwash_tenant_%`.* TO 'carwash'@'%';
#     FLUSH PRIVILEGES;
#   Fix B — reuse linked site DB: set LANDLORD_DB_DATABASE to DB_DATABASE value.
#   After either fix:
#     php artisan migrate --database=landlord --path=database/migrations/landlord --force
#     php artisan db:seed --class=ProductionSeeder --force
# ---------------------------------------------------------------------------
DB_CONNECTION=landlord
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=forge
DB_PASSWORD=
# DB_DATABASE=   ← Forge sets this when a database is linked to the site

# SSL — required for Forge/DO managed MySQL clusters (port 25060)
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
MYSQL_SSL_VERIFY_SERVER_CERT=false

LANDLORD_DB_DRIVER=mysql
LANDLORD_DB_CONNECTION=landlord
LANDLORD_DB_DATABASE=tamcarwash_landlord
# LANDLORD_DB_HOST / LANDLORD_DB_PORT / LANDLORD_DB_USERNAME / LANDLORD_DB_PASSWORD
# optional — default to DB_HOST / DB_PORT / DB_USERNAME / DB_PASSWORD

TENANT_DB_DRIVER=mysql
TENANT_DB_CONNECTION=tenant
TENANT_DB_PREFIX=tamcarwash_tenant_
# TENANT_DB_HOST / TENANT_DB_PORT / TENANT_DB_USERNAME / TENANT_DB_PASSWORD
# optional — default to DB_* ; tenant DBs created automatically on registration

# ---------------------------------------------------------------------------
# Multi-tenancy — subdirectory mode on the Forge temp domain
# ---------------------------------------------------------------------------
TENANCY_PLATFORM_DOMAIN=tamcarwash.on-forge.com
TENANCY_CENTRAL_DOMAINS=tamcarwash.on-forge.com
TENANCY_SUBDIRECTORY_ENABLED=true
TENANCY_RESERVED_PATHS=api,login,register,sanctum,up,landlord,build,storage,dashboard
TENANT_CACHE_STORE=file
TENANT_CACHE_PREFIX=tenant:
TENANT_CACHE_TTL=3600
TENANT_HEALTH_TIMEOUT=5
TENANCY_SEED_DEMO_USERS=true
ALLOW_QUICK_LOGIN=true

# ---------------------------------------------------------------------------
# Auth (Sanctum)
# ---------------------------------------------------------------------------
AUTH_GUARD=platform
SANCTUM_STATEFUL_DOMAINS=tamcarwash.on-forge.com

# ---------------------------------------------------------------------------
# Landlord super admin — /landlord/login (PlatformUserSeeder, every deploy)
#
# forge-deploy.sh bootstraps demo credentials below when Forge env is empty.
# Replace with real values in Forge → Site → Environment before go-live:
#   LANDLORD_ADMIN_EMAIL=ops@yourcompany.com
#   LANDLORD_ADMIN_PASSWORD=choose-a-strong-password
#   LANDLORD_ADMIN_NAME=مدير المنصة
#   LANDLORD_ADMIN_ROLE=admin
#
# Demo bootstrap (used when unset): admin@tammer.test / password
# Quick login on /landlord/login uses the same demo admin when ALLOW_QUICK_LOGIN=true.
# ---------------------------------------------------------------------------
LANDLORD_ADMIN_EMAIL=admin@tammer.test
LANDLORD_ADMIN_PASSWORD=password
LANDLORD_ADMIN_NAME=مدير المنصة
LANDLORD_ADMIN_ROLE=admin

# ---------------------------------------------------------------------------
# Session / Cache / Queue — file/sync drivers (this server has no Redis)
# ---------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=tamcarwash

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@tamcarwash.on-forge.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
