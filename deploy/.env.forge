# ---------------------------------------------------------------------------
# Tammer Wash — Production env template for Laravel Forge
# ---------------------------------------------------------------------------
# This file IS committed to git on purpose (no secrets here).
# deploy/forge-deploy.sh uses it to materialize/repair the server .env:
#   - If .env is missing on the server, it is created from this template.
#   - Operational keys below are force-synced into .env on every deploy.
#   - Secrets (APP_KEY, DB_PASSWORD) are generated/preserved on the server.
# When attaching a custom domain, update APP_URL + the three domain keys here.
# ---------------------------------------------------------------------------

APP_NAME="Tammer Wash"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tamcarwash.on-forge.com
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# Database — MySQL on the Forge server (no Docker/SQLite in production)
# DB_USERNAME / DB_PASSWORD: preserved from the server .env if present.
# If missing, Forge defaults are used (user "forge") — set the password once
# in Forge → Site → Environment, or in Forge → Database.
# ---------------------------------------------------------------------------
DB_CONNECTION=landlord
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=forge
DB_PASSWORD=

LANDLORD_DB_DRIVER=mysql
LANDLORD_DB_CONNECTION=landlord
LANDLORD_DB_DATABASE=tamcarwash_landlord

TENANT_DB_DRIVER=mysql
TENANT_DB_CONNECTION=tenant
TENANT_DB_PREFIX=tamcarwash_tenant_

# ---------------------------------------------------------------------------
# Multi-tenancy — subdirectory mode on the Forge temp domain
# ---------------------------------------------------------------------------
TENANCY_PLATFORM_DOMAIN=tamcarwash.on-forge.com
TENANCY_CENTRAL_DOMAINS=tamcarwash.on-forge.com
TENANCY_SUBDIRECTORY_ENABLED=true
TENANCY_RESERVED_PATHS=api,login,register,sanctum,up,landlord,build,storage,dashboard
TENANT_CACHE_STORE=file
TENANT_CACHE_PREFIX=tenant:
TENANT_CACHE_TTL=3600
TENANT_HEALTH_TIMEOUT=5
TENANCY_SEED_DEMO_USERS=true

# ---------------------------------------------------------------------------
# Auth (Sanctum)
# ---------------------------------------------------------------------------
AUTH_GUARD=platform
SANCTUM_STATEFUL_DOMAINS=tamcarwash.on-forge.com

# ---------------------------------------------------------------------------
# Session / Cache / Queue — file/sync drivers (this server has no Redis)
# ---------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=tamcarwash

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@tamcarwash.on-forge.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
