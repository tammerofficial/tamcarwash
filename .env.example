APP_NAME="Tammer Wash"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://tamcarwash.test
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Default connection (landlord connection name — not the SQL driver)
# ---------------------------------------------------------------------------
DB_CONNECTION=landlord

# =============================================================================
# LOCAL DEVELOPMENT — SQLite (no Docker / no MySQL)
# =============================================================================
# Copy these values into your local .env (never commit .env):
#
# LANDLORD_DB_DRIVER=sqlite
# LANDLORD_DB_CONNECTION=landlord
# LANDLORD_DB_DATABASE=/absolute/path/to/your/project/database/landlord.sqlite
#
# TENANT_DB_DRIVER=sqlite
# TENANT_DB_CONNECTION=tenant
# TENANT_SQLITE_DIRECTORY=/absolute/path/to/your/project/database/tenants
#
# SESSION_DRIVER=file
# QUEUE_CONNECTION=sync
# CACHE_STORE=file
# TENANT_CACHE_STORE=file

# =============================================================================
# PRODUCTION — Laravel Forge (tamcarwash.on-forge.com)
# =============================================================================
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://tamcarwash.on-forge.com
# PLATFORM_DOMAIN=tamcarwash.on-forge.com
# TENANCY_PLATFORM_DOMAIN=tamcarwash.on-forge.com
# TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1,tamcarwash.on-forge.com
# SESSION_DRIVER=file
# CACHE_STORE=file
# SESSION_DOMAIN=.tamcarwash.on-forge.com
# SANCTUM_STATEFUL_DOMAINS=tamcarwash.on-forge.com,*.tamcarwash.on-forge.com

# =============================================================================
# PRODUCTION — MySQL 8.4 (database-per-tenant)
# =============================================================================
LANDLORD_DB_DRIVER=mysql
LANDLORD_DB_CONNECTION=landlord

# Shared MySQL credentials (landlord + tenant connections)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=tamcarwash
DB_PASSWORD=secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

LANDLORD_DB_HOST=127.0.0.1
LANDLORD_DB_PORT=3306
LANDLORD_DB_DATABASE=tamcarwash_landlord
LANDLORD_DB_USERNAME=tamcarwash
LANDLORD_DB_PASSWORD=secret

TENANT_DB_DRIVER=mysql
TENANT_DB_CONNECTION=tenant
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_DATABASE=
TENANT_DB_USERNAME=tamcarwash
TENANT_DB_PASSWORD=secret
TENANT_DB_PREFIX=tamcarwash_tenant_

# ---------------------------------------------------------------------------
# Multi-tenancy
# ---------------------------------------------------------------------------
APP_URL=http://tamcarwash.test
PLATFORM_DOMAIN=tamcarwash.test
TENANCY_PLATFORM_DOMAIN=tamcarwash.test
TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1,tamcarwash.test,admin.tamcarwash.test,tamcarwash.on-forge.com
TENANCY_SUBDIRECTORY_ENABLED=true
TENANCY_RESERVED_PATHS=api,login,register,sanctum,up,landlord,build,storage,dashboard
TENANT_CACHE_STORE=file  # use redis in production with Docker
TENANT_CACHE_PREFIX=tenant:
TENANT_CACHE_TTL=3600
TENANT_HEALTH_TIMEOUT=5

# ---------------------------------------------------------------------------
# Auth (Sanctum)
# ---------------------------------------------------------------------------
AUTH_GUARD=platform

# Optional override for web/FCGI; CLI artisan sets 512M in artisan
# PHP_MEMORY_LIMIT=512M
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8000,localhost:8002,127.0.0.1,127.0.0.1:8000,127.0.0.1:8002,127.0.0.1:8010,tamcarwash.test,*.tamcarwash.test

# ---------------------------------------------------------------------------
# Session / Cache / Queue
# ---------------------------------------------------------------------------
# Local dev without Docker/Redis — use file drivers instead of redis:
# SESSION_DRIVER=file
# QUEUE_CONNECTION=sync
# CACHE_STORE=file
# TENANT_CACHE_STORE=file

SESSION_DRIVER=file  # use redis in production
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.tamcarwash.test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync  # use redis in production

CACHE_STORE=file  # use redis in production
CACHE_PREFIX=tamcarwash

# ---------------------------------------------------------------------------
# Redis (Predis client)
# ---------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ---------------------------------------------------------------------------
# Laravel Forge scheduled jobs (optional heartbeat)
# ---------------------------------------------------------------------------
FORGE_HEARTBEAT_URL=

# ---------------------------------------------------------------------------
# Docker Compose overrides
# ---------------------------------------------------------------------------
# If macOS/Homebrew MySQL already listens on 3306, use 3307 here and set
# DB_PORT, LANDLORD_DB_PORT, and TENANT_DB_PORT to the same value.
# Keep LANDLORD_DB_DATABASE=tamcarwash_landlord (not a .sqlite path) — Compose
# uses it for MYSQL_DATABASE on first container init.
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=secret
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@tamcarwash.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AWS (optional — media library / backups)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Default storefront contact info (Kuwait)
TAMMER_DEFAULT_PHONE="+965 18XXXXXX"
TAMMER_DEFAULT_ADDRESS="العاصمة ، الكويت"
