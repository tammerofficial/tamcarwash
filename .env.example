APP_NAME="Tammer Wash"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://tamcarwash.test
APP_TIMEZONE=Asia/Riyadh

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Default connection (landlord for platform operations)
# ---------------------------------------------------------------------------
DB_CONNECTION=landlord

# Shared MySQL credentials (used by landlord + tenant connections)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=tamcarwash
DB_PASSWORD=secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ---------------------------------------------------------------------------
# Landlord (platform) database
# ---------------------------------------------------------------------------
LANDLORD_DB_CONNECTION=landlord
LANDLORD_DB_HOST=127.0.0.1
LANDLORD_DB_PORT=3306
LANDLORD_DB_DATABASE=tamcarwash_landlord
LANDLORD_DB_USERNAME=tamcarwash
LANDLORD_DB_PASSWORD=secret

# ---------------------------------------------------------------------------
# Tenant database connection template (database name set dynamically per tenant)
# ---------------------------------------------------------------------------
TENANT_DB_CONNECTION=tenant
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_DATABASE=
TENANT_DB_USERNAME=tamcarwash
TENANT_DB_PASSWORD=secret
TENANT_DB_PREFIX=tamcarwash_tenant_

# ---------------------------------------------------------------------------
# Multi-tenancy
# ---------------------------------------------------------------------------
TENANCY_PLATFORM_DOMAIN=tamcarwash.test
TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1,tamcarwash.test,admin.tamcarwash.test
TENANT_CACHE_STORE=redis
TENANT_CACHE_PREFIX=tenant:
TENANT_CACHE_TTL=3600
TENANT_HEALTH_TIMEOUT=5

# ---------------------------------------------------------------------------
# Auth (Sanctum)
# ---------------------------------------------------------------------------
AUTH_GUARD=platform

# Optional override for web/FCGI; CLI artisan sets 512M in artisan
# PHP_MEMORY_LIMIT=512M
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,tamcarwash.test,*.tamcarwash.test

# ---------------------------------------------------------------------------
# Session / Cache / Queue
# ---------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.tamcarwash.test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=tamcarwash

# ---------------------------------------------------------------------------
# Redis (Predis client)
# ---------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ---------------------------------------------------------------------------
# Docker Compose overrides
# ---------------------------------------------------------------------------
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=secret
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@tamcarwash.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AWS (optional — media library / backups)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
